{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ajayasai.github.io/OpenConstraint/schemas/openconstraint-report.schema.json",
  "title": "OpenConstraint audit report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tool", "design", "summary", "modes", "diagnostics"],
  "properties": {
    "schema_version": {
      "const": "1.1.0"
    },
    "tool": {
      "$ref": "#/$defs/tool"
    },
    "design": {
      "$ref": "#/$defs/design"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "modes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/mode"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    }
  },
  "$defs": {
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "const": "OpenConstraint"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "design": {
      "type": "object",
      "description": "Design inventory. Additional properties are allowed for compatible inventory extensions.",
      "required": [
        "top",
        "ports",
        "nets",
        "instances",
        "sequential_instances",
        "sequential_endpoints",
        "parser_warnings"
      ],
      "properties": {
        "top": {
          "type": "string"
        },
        "ports": {
          "type": "integer",
          "minimum": 0
        },
        "nets": {
          "type": "integer",
          "minimum": 0
        },
        "instances": {
          "type": "integer",
          "minimum": 0
        },
        "sequential_instances": {
          "type": "integer",
          "minimum": 0
        },
        "sequential_endpoints": {
          "type": "integer",
          "minimum": 0
        },
        "parser_warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["diagnostic_count", "errors", "warnings", "notes", "mode_count", "coverage"],
      "properties": {
        "diagnostic_count": {
          "type": "integer",
          "minimum": 0
        },
        "errors": {
          "type": "integer",
          "minimum": 0
        },
        "warnings": {
          "type": "integer",
          "minimum": 0
        },
        "notes": {
          "type": "integer",
          "minimum": 0
        },
        "mode_count": {
          "type": "integer",
          "minimum": 1
        },
        "coverage": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        },
        "opensta": {
          "$ref": "#/$defs/opensta_summary"
        },
        "adoption": {
          "$ref": "#/$defs/adoption_summary"
        }
      }
    },
    "adoption_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fingerprint_algorithm",
        "raw_diagnostic_count",
        "active_diagnostic_count",
        "waived_count",
        "baselined_count",
        "unused_waiver_count",
        "stale_baseline_count",
        "strict",
        "strict_failure",
        "waiver_sources",
        "baseline_source",
        "baseline_generated_by_version",
        "dispositions",
        "unused_waivers",
        "stale_baseline_diagnostics"
      ],
      "properties": {
        "fingerprint_algorithm": {
          "const": "openconstraint/v1"
        },
        "raw_diagnostic_count": {
          "type": "integer",
          "minimum": 0
        },
        "active_diagnostic_count": {
          "type": "integer",
          "minimum": 0
        },
        "waived_count": {
          "type": "integer",
          "minimum": 0
        },
        "baselined_count": {
          "type": "integer",
          "minimum": 0
        },
        "unused_waiver_count": {
          "type": "integer",
          "minimum": 0
        },
        "stale_baseline_count": {
          "type": "integer",
          "minimum": 0
        },
        "strict": {
          "type": "boolean"
        },
        "strict_failure": {
          "type": "boolean"
        },
        "waiver_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/control_source"
          }
        },
        "baseline_source": {
          "oneOf": [
            {
              "$ref": "#/$defs/control_source"
            },
            {
              "type": "null"
            }
          ]
        },
        "baseline_generated_by_version": {
          "type": ["string", "null"]
        },
        "dispositions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic_disposition"
          }
        },
        "unused_waivers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/unused_waiver"
          }
        },
        "stale_baseline_diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/baseline_diagnostic"
          }
        }
      }
    },
    "control_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "schema_version"],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "schema_version": {
          "const": "1.0.0"
        }
      }
    },
    "diagnostic_disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "diagnostic", "source_path", "waiver_id", "reason", "expires"],
      "properties": {
        "status": {
          "enum": ["waived", "baselined"]
        },
        "diagnostic": {
          "$ref": "#/$defs/diagnostic"
        },
        "source_path": {
          "type": "string"
        },
        "waiver_id": {
          "type": ["string", "null"]
        },
        "reason": {
          "type": ["string", "null"]
        },
        "expires": {
          "oneOf": [
            {
              "type": "string",
              "format": "date",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "unused_waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fingerprint", "rule_id", "severity", "mode", "reason", "expires", "source_path"],
      "properties": {
        "id": {
          "type": "string"
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{20}$"
        },
        "rule_id": {
          "type": "string",
          "pattern": "^OC[0-9]{4}$"
        },
        "severity": {
          "enum": ["error", "warning", "note"]
        },
        "mode": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "expires": {
          "type": ["string", "null"]
        },
        "source_path": {
          "type": "string"
        }
      }
    },
    "baseline_diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fingerprint", "rule_id", "severity", "mode", "message", "location"],
      "properties": {
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{20}$"
        },
        "rule_id": {
          "type": "string",
          "pattern": "^OC[0-9]{4}$"
        },
        "severity": {
          "enum": ["error", "warning", "note"]
        },
        "mode": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/location"
        }
      }
    },
    "opensta_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "succeeded", "modes"],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "succeeded": {
          "type": "boolean"
        },
        "modes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/opensta_mode"
          }
        }
      }
    },
    "opensta_mode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "succeeded",
        "return_code",
        "timed_out",
        "duration_seconds",
        "effective_sdc_sha256",
        "failure_reason",
        "stdout",
        "stderr",
        "effective_audit"
      ],
      "properties": {
        "mode": {
          "type": "string"
        },
        "succeeded": {
          "type": "boolean"
        },
        "return_code": {
          "type": ["integer", "null"]
        },
        "timed_out": {
          "type": "boolean"
        },
        "duration_seconds": {
          "type": "number",
          "minimum": 0
        },
        "effective_sdc_sha256": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "failure_reason": {
          "type": ["string", "null"]
        },
        "stdout": {
          "type": "string"
        },
        "stderr": {
          "type": "string"
        },
        "effective_audit": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "coverage",
                "diagnostic_count",
                "added_diagnostic_count",
                "static_semantic_sha256",
                "effective_semantic_sha256",
                "semantic_match"
              ],
              "properties": {
                "coverage": {"$ref": "#/$defs/coverage"},
                "diagnostic_count": {"type": "integer", "minimum": 0},
                "added_diagnostic_count": {"type": "integer", "minimum": 0},
                "static_semantic_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "effective_semantic_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "semantic_match": {"type": "boolean"}
              }
            },
            {"type": "null"}
          ]
        }
      }
    },
    "mode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "coverage", "clocks", "exceptions", "io_delays", "graph", "diagnostics"],
      "properties": {
        "name": {
          "type": "string"
        },
        "coverage": {
          "$ref": "#/$defs/coverage"
        },
        "clocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/clock"
          }
        },
        "exceptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/exception"
          }
        },
        "io_delays": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/io_delay"
          }
        },
        "graph": {
          "$ref": "#/$defs/graph"
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "grade", "components"],
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "grade": {
          "enum": ["A", "B", "C", "D", "F"]
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/coverage_component"
          }
        }
      }
    },
    "coverage_component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "covered", "total", "percentage", "weight", "explanation"],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        },
        "covered": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "percentage": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 100
        },
        "weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "explanation": {
          "type": "string"
        }
      }
    },
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "targets",
        "period",
        "waveform",
        "waveform_explicit",
        "valid",
        "generated",
        "source_targets",
        "master_clock",
        "divide_by",
        "multiply_by",
        "duty_cycle",
        "invert",
        "combinational",
        "edges",
        "edge_shift",
        "location"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "targets": {
          "$ref": "#/$defs/string_set"
        },
        "period": {
          "type": ["number", "null"]
        },
        "waveform": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "waveform_explicit": {
          "type": "boolean"
        },
        "valid": {
          "type": "boolean"
        },
        "generated": {
          "type": "boolean"
        },
        "source_targets": {
          "$ref": "#/$defs/string_set"
        },
        "master_clock": {
          "type": ["string", "null"]
        },
        "divide_by": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "multiply_by": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "duty_cycle": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 100
        },
        "invert": {
          "type": "boolean"
        },
        "combinational": {
          "type": "boolean"
        },
        "edges": {
          "oneOf": [
            {
              "type": "array",
              "items": {"type": "integer", "minimum": 1}
            },
            {"type": "null"}
          ]
        },
        "edge_shift": {
          "oneOf": [
            {
              "type": "array",
              "items": {"type": "number"}
            },
            {"type": "null"}
          ]
        },
        "location": {
          "$ref": "#/$defs/location"
        }
      }
    },
    "io_delay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ports",
        "value",
        "clocks",
        "reference_pin",
        "source_latency_included",
        "network_latency_included",
        "min_max",
        "transitions",
        "clock_edge",
        "additive",
        "valid",
        "location",
        "raw"
      ],
      "properties": {
        "kind": {"enum": ["input", "output"]},
        "ports": {"$ref": "#/$defs/string_set"},
        "value": {"type": ["number", "null"]},
        "clocks": {"$ref": "#/$defs/string_set"},
        "reference_pin": {"type": ["string", "null"]},
        "source_latency_included": {"type": "boolean"},
        "network_latency_included": {"type": "boolean"},
        "min_max": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["min", "max"]}
        },
        "transitions": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["rise", "fall"]}
        },
        "clock_edge": {"enum": ["rise", "fall"]},
        "additive": {"type": "boolean"},
        "valid": {"type": "boolean"},
        "location": {"$ref": "#/$defs/location"},
        "raw": {"type": "string"}
      }
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "from", "to", "through", "location", "raw", "qualifiers"],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "$ref": "#/$defs/string_set"
        },
        "to": {
          "$ref": "#/$defs/string_set"
        },
        "through": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/string_set"
          }
        },
        "location": {
          "$ref": "#/$defs/location"
        },
        "raw": {
          "type": "string"
        },
        "qualifiers": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "multiplier": {
              "type": ["integer", "null"]
            },
            "applies_to": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": ["setup", "hold"]
              }
            },
            "start_end": {
              "enum": ["default", "start", "end"]
            },
            "from_transition": {
              "enum": ["rise", "fall", "rise_fall"]
            },
            "to_transition": {
              "enum": ["rise", "fall", "rise_fall"]
            },
            "end_transition": {
              "enum": ["rise", "fall", "rise_fall"]
            },
            "through_transitions": {
              "type": "array",
              "items": {
                "enum": ["rise", "fall", "rise_fall"]
              }
            },
            "from_specified": {
              "type": "boolean"
            },
            "to_specified": {
              "type": "boolean"
            },
            "scope_resolvable": {
              "type": "boolean"
            },
            "definition_valid": {
              "type": "boolean"
            },
            "definition_problems": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "reset_path": {
              "type": "boolean"
            },
            "delay": {
              "type": ["number", "null"]
            },
            "probe": {
              "type": "boolean"
            },
            "ignore_clock_latency": {
              "type": "boolean"
            },
            "relation": {
              "enum": ["asynchronous", "logically_exclusive", "physically_exclusive", "exclusive", "unspecified"]
            },
            "allow_paths": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes", "edges"],
      "properties": {
        "nodes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/graph_node"
          }
        },
        "edges": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/graph_edge"
          }
        }
      }
    },
    "graph_node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "kind"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "graph_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target", "kind"],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "through_index": {
          "type": "integer",
          "minimum": 0
        },
        "transition": {
          "enum": ["rise", "fall", "rise_fall"]
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "severity",
        "message",
        "location",
        "rationale",
        "suggestion",
        "mode",
        "fingerprint",
        "evidence"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "pattern": "^OC[0-9]{4}$"
        },
        "severity": {
          "enum": ["error", "warning", "note"]
        },
        "message": {
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/location"
        },
        "rationale": {
          "type": "string"
        },
        "suggestion": {
          "type": "string"
        },
        "mode": {
          "type": "string"
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{20}$"
        },
        "evidence": {
          "type": "object",
          "description": "Rule-specific JSON evidence. Rule implementations may add fields compatibly.",
          "additionalProperties": true
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "line", "column"],
      "properties": {
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "string_set": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    }
  }
}
