{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ajayasai.github.io/OpenConstraint/schemas/openconstraint-diagnostic-baseline.schema.json",
  "title": "OpenConstraint diagnostic baseline",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "fingerprint_algorithm",
    "generated_by",
    "design",
    "diagnostics"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "kind": {
      "const": "openconstraint-diagnostic-baseline"
    },
    "fingerprint_algorithm": {
      "const": "openconstraint/v1"
    },
    "generated_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "const": "OpenConstraint"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        }
      }
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": ["top"],
      "properties": {
        "top": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "maxItems": 100000,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/diagnostic_snapshot"
      }
    }
  },
  "$defs": {
    "diagnostic_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fingerprint", "rule_id", "severity", "mode", "message", "location"],
      "properties": {
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{20}$"
        },
        "rule_id": {
          "type": "string",
          "pattern": "^OC[0-9]{4}$"
        },
        "severity": {
          "enum": ["error", "warning", "note"]
        },
        "mode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "location": {
          "$ref": "#/$defs/location"
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "line", "column"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
