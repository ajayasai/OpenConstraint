{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ajayasai.github.io/OpenConstraint/schemas/openconstraint-functional-spec.schema.json",
  "title": "OpenConstraint Boolean influence spec (not timing signoff)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "model",
    "top",
    "checks"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "model": {
      "const": "zero_delay_arbitrary_state"
    },
    "top": {
      "type": "string",
      "minLength": 1
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/check"
      }
    }
  },
  "$defs": {
    "reference": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "net",
            "bit"
          ],
          "properties": {
            "net": {
              "type": "string",
              "minLength": 1
            },
            "bit": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sources",
        "targets"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "signal",
              "value"
            ],
            "properties": {
              "signal": {
                "$ref": "#/$defs/reference"
              },
              "value": {
                "type": "integer",
                "enum": [
                  0,
                  1
                ]
              }
            }
          }
        }
      }
    }
  }
}
