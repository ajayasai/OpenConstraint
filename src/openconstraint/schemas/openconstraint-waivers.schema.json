{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ajayasai.github.io/OpenConstraint/schemas/openconstraint-waivers.schema.json",
  "title": "OpenConstraint diagnostic waivers",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "waivers"],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "kind": {
      "const": "openconstraint-waivers"
    },
    "waivers": {
      "type": "array",
      "maxItems": 100000,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/waiver"
      }
    }
  },
  "$defs": {
    "waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fingerprint", "rule_id", "severity", "mode", "reason"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{20}$"
        },
        "rule_id": {
          "type": "string",
          "pattern": "^OC[0-9]{4}$"
        },
        "severity": {
          "enum": ["error", "warning", "note"]
        },
        "mode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "expires": {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    }
  }
}
