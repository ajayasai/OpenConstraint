library (openconstraint_demo) {
  time_unit : "1ns";
  cell (DFF) {
    area : 1.0;
    ff (IQ, IQN) {
      clocked_on : "CLK";
      next_state : "D";
      clear : "!RN";
    }
    pin (D)   { direction : input; }
    pin (CLK) { direction : input; clock : true; }
    pin (RN)  { direction : input; }
    pin (Q)   { direction : output; }
  }
}
