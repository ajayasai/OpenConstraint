      "description": "Append query filters that are outside the deterministic static subset or explicitly empty.",
      "execution": "mutant-only",
      "mutations": [
        {
          "kind": "append",
          "text": "set_false_path -from [get_ports -filter {name == data_a} data_a] -to [get_ports result_a]\nset_false_path -from [get_ports -filter {} *] -to [get_ports result_a]\n"
