{
  "schema_version": "1.0.0",
  "suite": {
    "id": "synthetic-sdc-defects",
    "name": "Synthetic SDC defect truth set",
    "description": "Deterministic, reviewable mutations over a small project-authored structural fixture, scored by expected diagnostic rule IDs."
  },
  "fixture": {
    "id": "dual-register-direct-clock",
    "description": "Two directly clocked flip-flops with fully constrained scalar interfaces and one unrelated spare input.",
    "top": "accuracy_top",
    "verilog": "module accuracy_top (\n    input wire clk,\n    input wire scan_clk,\n    input wire reset_n,\n    input wire data_a,\n    input wire data_b,\n    output wire result_a,\n    output wire result_b\n);\n  DFFR u_ff0 (.D(data_a), .CLK(clk), .RN(reset_n), .Q(result_a));\n  DFFR u_ff1 (.D(data_b), .CLK(clk), .RN(reset_n), .Q(result_b));\nendmodule\n",
    "liberty": "library (accuracy_cells) {\n  cell (DFFR) {\n    ff (IQ, IQN) { clocked_on : \"CLK\"; next_state : \"D\"; }\n    pin (D) { direction : input; }\n    pin (CLK) { direction : input; clock : true; }\n    pin (RN) { direction : input; }\n    pin (Q) { direction : output; }\n  }\n}\n",
    "sdc": "create_clock -name core_clk -period 10 -waveform {0 5} [get_ports clk]\nset_input_delay 2 -clock core_clk [get_ports {scan_clk reset_n data_a data_b}]\nset_output_delay 2 -clock core_clk [get_ports {result_a result_b}]\n",
    "license": {
      "spdx": "Apache-2.0",
      "provenance": "Project-authored synthetic fixture; no proprietary or third-party design content."
    }
  },
  "options": {
    "broad_match_count": 50,
    "broad_match_ratio": 0.8,
    "broad_match_min_universe": 5,
    "report_implicit_waveform": true
  },
  "thresholds": {
    "minimum_precision": 1.0,
    "minimum_recall": 1.0,
    "maximum_false_pass_rate": 0.0
  },
  "cases": [
    {
      "id": "clean-control",
      "description": "The unmodified fixture must remain diagnostic-free.",
      "execution": "mutant-only",
      "mutations": [],
      "expected": []
    },
    {
      "id": "malformed-sdc",
      "description": "Append an unterminated object-query substitution.",
      "execution": "mutant-only",
      "mutations": [
        {
          "kind": "append",
          "text": "set_false_path -from [get_ports data_a\n"
        }
      ],
      "expected": [
        {
          "rule_id": "OC0001",
          "count": 1
        }
      ]
    },
    {
      "id": "zero-object-query",
      "description": "Append an exception whose source collection names no design object.",
      "execution": "mutant-only",
      "mutations": [
        {
          "kind": "append",
          "text": "set_false_path -from [get_ports missing_input] -to [get_ports result_a]\n"
        }
      ],
      "expected": [
        {
          "rule_id": "OC1001",
          "count": 1
        }
      ]
    },
    {
      "id": "explicit-empty-object-query",
      "description": "Append an exception whose explicitly empty Tcl pattern must remain an empty collection rather than widening to every port.",
      "execution": "mutant-only",
      "mutations": [
        {
          "kind": "append",
          "text": "set_false_path -from [get_ports {}] -to [get_ports result_a]\n"
        }
      ],
      "expected": [
        {
          "rule_id": "OC1001",
          "count": 1
        }
      ]
    },
    {
      "id": "dangerously-broad-query",
      "description": "Append an exception that selects every port through a wildcard.",
      "execution": "mutant-only",
      "mutations": [
        {
          "kind": "append",
          "text": "set_false_path -from [get_ports *] -to [get_ports result_a]\n"
        }
      ],
      "expected": [
        {
          "rule_id": "OC1002",
          "count": 1
        }
      ]
    },
    {
      "id": "implicit-wildcard-query",
      "description": "Append a bare OpenSTA-compatible get_ports query whose implicit wildcard remains eligible for broad-query review.",
      "execution": "mutant-only",
      "mutations": [
        {
          "kind": "append",
          "text": "set_false_path -from [get_ports] -to [get_ports result_a]\n"
        }
      ],
      "expected": [
        {
          "rule_id": "OC1002",
          "count": 1
        }
      ]
    },
    {
      "id": "dynamic-query",
      "description": "Append a variable-dependent query that the static backend cannot resolve.",
      "execution": "mutant-only",
      "mutations": [
        {
          "kind": "append",
          "text": "set_false_path -from [get_ports $dynamic_input] -to [get_ports result_a]\n"
        }
      ],
      "expected": [
        {
          "rule_id": "OC1003",
          "count": 1
        }
      ]
    },
    {
