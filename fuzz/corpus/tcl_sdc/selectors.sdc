set_false_path -from [get_ports] -to [get_ports result]
set_false_path -from [get_ports {}] -to [get_ports result]
set_false_path -from [get_cells -of_objects [get_nets q]] -to [all_registers]
set_false_path -from [get_ports first second] -to [get_ports result]
set_false_path -from [get_pins -hsc . u0.D] -to [get_ports -filter]
set_input_delay 1 -clock core [all_inputs -no_clocks]
set_false_path -from [get_cells -of_objects {[get_nets q]}] -to [get_nets {-quiet}]
set_false_path -from [get_clocks -of_objects [get_ports missing]] -to [get_ports -q result]
set_input_delay 1 -clock core [all_inputs ignored]
set_false_path -from [get_ports { -quiet }] -to [get_ports result]
set_false_path -from [get_ports {-q } data] -to [get_ports result]
set_false_path -from [get_ports -filter {} *] -to [get_ports result]
